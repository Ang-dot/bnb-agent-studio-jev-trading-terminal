# Server-only placeholders. Copy to .env.local and fill in your own values.
# Never commit populated files or place provider secrets in VITE_* variables.
PORT=8787
HOSTING_MODE=local

# OpenRouter: JEV judgments and Grok native X search.
OPENROUTER_API_KEY=
# Blank overrides use server defaults; verify provider/model compatibility.
JEV_MODEL=
# Default research model; JEV_MODEL is a separate typed decision model.
GROK_MODEL=x-ai/grok-4.3

# GMGN: environment authentication or configure the CLI outside this repo.
GMGN_API_KEY=
# Absolute executable path; blank uses ~/.local/bin/gmgn-cli.
GMGN_CLI_PATH=

# GeckoTerminal on-chain Demo API. Server-only; no daily cap, 9,000 app requests/month.
MARKET_PRICE_PROVIDER=coingecko
COINGECKO_DEMO_API_KEY=

# Legacy alternative only: MARKET_PRICE_PROVIDER=bitquery. No automatic fallback.
BITQUERY_CLIENT_ID=
BITQUERY_CLIENT_SECRET=

# KBW: API key from a dedicated Mem9 Space (not an Admin API key).
# Backend only. Existing Living Brain history is not imported.
MEM9_API_KEY=
MEM9_API_URL=https://api.mem9.ai
MEM9_APP_ID=jev-kbw

# TOKEN2049: use a dedicated development brain, not production memory.
LIVING_BRAIN_API_KEY=
LIVING_BRAIN_SUBJECT_ID=
LIVING_BRAIN_ID=

# Optional chain inspection. Never provide a signing key.
NODEREAL_API_KEY=
AGENT_WALLET_ADDRESS=
AGENT_ID=

# Blank uses local SQLite; cloud mode requires a TLS Postgres database URL.
SUPABASE_DATABASE_URL=
# Optional CA certificate for verifying the Supabase database server.
SUPABASE_DB_CA_PATH=
# For hosts without a mounted certificate file, use a protected Base64 CA binding.
SUPABASE_DB_CA_BASE64=

# Cloud only. This flag does not disable the local discovery worker.
WORKER_ENABLED=false
# Limit background assessments and memory to an edition; comma-separated.
# Omitted means both editions. Use kbw for the KBW-only production worker.
WORKER_EDITIONS=kbw,token2049
PUBLIC_ORIGIN=
ORIGIN_SECRET=
CF_ACCESS_ISSUER=
CF_ACCESS_AUDIENCE=
OPERATOR_EMAIL=

# Pages server-side binding only; not consumed by the Node backend.
BACKEND_ORIGIN=
