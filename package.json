{
  "name": "jev-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --import tsx --env-file-if-exists=.env.local server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx --env-file-if-exists=.env.local server/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@bnbagent/sdk": "0.6.0",
    "@bnbagent/studio-runtime": "0.0.14",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pg": "8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.38.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "4.1.11"
  }
}
